{
  "name": "kjp-port-simulator",
  "private": true,
  "version": "2.0.0",
  "description": "Simulateur pédagogique et générateur communautaire de ports KJP",
  "devDependencies": {
    "esbuild": "0.25.11",
    "ol": "10.10.0",
    "playwright": "1.61.1",
    "three": "0.186.0"
  },
  "scripts": {
    "check:i18n": "node scripts/check-simulator-i18n.js",
    "test:i18n": "node scripts/run-validation.js --suite i18n",
    "test:i18n:unit": "node scripts/run-validation.js --suite i18n --group unit",
    "test:i18n:ui": "node scripts/run-validation.js --suite i18n --group ui",
    "build:simulator": "node scripts/build-simulateur-port.js",
    "capture:renderer:native-baseline": "node scripts/capture-simulator-native-baseline.js",
    "profile:renderer:native": "node scripts/profile-simulator-native-renderer.js",
    "qualify:renderer:native": "node scripts/qualify-simulator-native-activation.js",
    "test:rendering": "node --test tests/native-rendering.test.js",
    "test:renderer:quick": "node --test --test-concurrency=1 tests/native-world-renderer.test.js tests/native-player.test.js tests/native-renderer-activation.test.js tests/understanding-rotation.test.js",
    "test:renderer:qualification": "node --test --test-concurrency=1 tests/native-rendering.test.js tests/native-world-renderer.test.js tests/native-player.test.js tests/native-renderer-activation.test.js tests/native-renderer-qualification.test.js tests/understanding-rotation.test.js",
    "build:port-generator": "node scripts/build-port-generator.js",
    "check:build": "node scripts/build-simulateur-port.js --check",
    "check:port-generator": "node scripts/build-port-generator.js --check",
    "audit:wind-current": "node scripts/audit-wind-current.js",
    "audit:dynamic-mooring": "node scripts/audit-dynamic-mooring.js",
    "check:wind-current": "node scripts/audit-wind-current.js --check",
    "test:ports": "node --test tests/ports/*.test.js",
    "test:physics:core": "node --test tests/physics/port-physics.test.js",
    "test:physics:environment": "node --test tests/physics/wind-current-profiles.test.js",
    "test:physics:contacts": "node --test tests/physics/port-obstacles.test.js",
    "test:physics": "node --test --test-concurrency=1 tests/physics/*.test.js",
    "test:e2e": "node scripts/run-validation.js --suite simulator",
    "test:smoke": "node scripts/run-validation.js --suite simulator --group smoke",
    "test:ui:controls": "node scripts/run-validation.js --route ui-check --group controls",
    "test:ui:ports": "node scripts/run-validation.js --route ui-check --group ports",
    "test:ui:moorings": "node scripts/run-validation.js --route ui-check --group moorings",
    "test:ui:guide": "node scripts/run-validation.js --route ui-check --group guide",
    "test:port-generator": "node scripts/run-validation.js --suite generator",
    "test:validation": "node --test tests/validation-routing.test.js",
    "qualify:performance": "node scripts/run-validation.js --suite performance",
    "validate:patch": "node scripts/run-validation.js --route patch-local",
    "validate:ui": "node scripts/run-validation.js --route ui-check",
    "validate:physics": "node scripts/run-validation.js --route physics-check",
    "validate:release": "node scripts/run-validation.js --route release-check --product all",
    "check:simulator": "npm run check:build",
    "check:generator": "npm run check:port-generator",
    "verify:physics": "node scripts/run-validation.js --route physics-check --component transversal",
    "verify:simulator": "node scripts/run-validation.js --route release-check --product simulator",
    "verify:port-generator": "node scripts/run-validation.js --route release-check --product generator",
    "verify:release": "node scripts/run-validation.js --route release-check --product all"
  }
}
