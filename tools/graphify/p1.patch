--- /dev/null
+++ b/graphify/extractors/html_scripts.py
@@ -0,0 +1,39 @@
+"""Structural JavaScript extraction from source HTML, preserving source lines."""
+from __future__ import annotations
+import re
+from pathlib import Path
+
+_SCRIPT = re.compile(rb"<script\b([^>]*)>(.*?)</script\s*>", re.I | re.S)
+_ATTR = re.compile(rb"([\w-]+)\s*=\s*(?:\"([^\"]*)\"|'([^']*)'|([^\s>]+))", re.I)
+
+def extract_html_scripts(path: Path) -> dict:
+    from graphify.extract import _JS_CONFIG
+    from graphify.extractors.engine import _extract_generic
+    source = path.read_bytes()
+    masked = bytearray(10 if byte == 10 else 32 for byte in source)
+    for script in _SCRIPT.finditer(source):
+        attrs = {m[1].lower(): next((v for v in m.groups()[1:] if v is not None), b"").lower()
+                 for m in _ATTR.finditer(script[1])}
+        if b"src" in attrs:
+            continue
+        kind = attrs.get(b"type", b"")
+        if kind not in {b"", b"module", b"text/javascript", b"application/javascript"}:
+            continue
+        start, end = script.span(2)
+        masked[start:end] = source[start:end]
+    result = _extract_generic(path, _JS_CONFIG, source_override=bytes(masked))
+    # A curated page and its script module are distinct entities. Reusing the
+    # canonical page id would overwrite its semantic label during an update.
+    page = next((n for n in result.get("nodes", []) if n.get("label") == path.name), None)
+    if page is not None:
+        old_id = page["id"]
+        page["id"] = old_id + "_inline_scripts"
+        page["node_kind"] = "script_module"
+        for edge in result.get("edges", []):
+            for key in ("source", "target"):
+                if edge.get(key) == old_id:
+                    edge[key] = page["id"]
+        for call in result.get("raw_calls", []):
+            if call.get("caller_nid") == old_id:
+                call["caller_nid"] = page["id"]
+    return result
